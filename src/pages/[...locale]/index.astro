---
import { render, getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import config, { monolocale } from "$config";
import Time from "$lib/time";
import Base from "$layouts/Base.astro";
import Logo from "$icons/site-logo.svg";
import i18nit from "$i18n";

export async function getStaticPaths() {
	// Create path for each locale, omitting default locale from URL
	return config.i18n.locales.map(locale => ({ params: { locale: config.i18n.defaultLocale === locale ? undefined : locale } }));
}

const { locale = config.i18n.defaultLocale } = Astro.params;

const t = i18nit(locale);

// Get preface content for current locale, sorted by timestamp (latest first)
const prefaces = (
	await getCollection("preface", preface => {
		// Handle single locale setup
		if (monolocale) return true;

		// Extract language and ID from file path structure
		const [language, id] = preface.id.split("/");
		preface.id = id;

		// Filter by current locale
		return language === locale;
	})
).sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime());

// Get published notes for current locale
const notes = await getCollection("note", note => {
	// Assign type property
	Reflect.set(note, "type", "note");

	// Filter by publication status and locale
	let published = !note.data.draft;
	let localed = monolocale || note.id.split("/")[0] === locale;

	// Filter published notes by current locale
	return published && localed;
});

// Get published jottings for current locale
const jottings = await getCollection("jotting", jotting => {
	// Assign type property
	Reflect.set(jotting, "type", "jotting");

	// Check monolocale setup or extract language to match locale
	let localed = monolocale || jotting.id.split("/")[0] === locale;

	// Filter published notes by current locale
	return !jotting.data.draft && localed;
});

// 主页序言：最新一篇 featured: true 的序文（没有 featured 时回退到最新序文）
const preface = prefaces.find(p => p.data.featured) || prefaces[0];
// Render preface content if available, otherwise use empty object
const { Content } = preface ? await render(preface) : ({} as any);

// 最新内容：文记与随笔分开，各取最新 3 条
const recentNotes = notes.sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime()).slice(0, 3);
const recentJotList = jottings.sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime()).slice(0, 3);

// 片羽：只显示最新 1 条随笔（Markdown 渲染，与详情页一致）
const recentJottings = await Promise.all(
	jottings
		.sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime())
		.slice(0, 1)
		.map(async jotting => ({ ...jotting, Content: (await render(jotting)).Content }))
);
---

<Base title={t("navigation.home")} {locale}>
	<main class="flex flex-col gap-5 sm:gap-20 grow">
		<header class="flex items-center justify-center flex-wrap-reverse grow-[0.6]">
			{config.prologue && <article class="me-auto font-cursive font-thin text-xl sm:text-2xl leading-loose whitespace-pre-line">{config.prologue}</article>}
			<Logo width={100} />
		</header>

		{
			preface && (
				<section class="flex flex-col">
					<article class="markdown">
						<Content />
					</article>
					<a href={getRelativeLocaleUrl(locale, "/preface")} class="self-end my-2 text-sm text-secondary">
						—— {Time.toLocaleDateString(preface.data.timestamp, locale)}
					</a>
				</section>
			)
		}

		{
			(recentNotes.length > 0 || recentJotList.length > 0) && (
				<section class="flex flex-col gap-4">
					<h4 class="flex items-center gap-2 text-lg font-bold">
						最新内容
						<span class="grow border-t border-weak"></span>
					</h4>

					{/* 左右两列：文记 | 随笔（中间虚线分割） */}
					<div class="flex flex-col sm:flex-row gap-6">
						<div class="sm:w-1/2 flex flex-col gap-2 sm:pe-6 sm:border-e sm:border-dashed sm:border-weak">
							<h5 class="text-sm font-bold text-secondary">文记</h5>
							{
								recentNotes.length > 0 ? (
									recentNotes.map(item => (
										<article class="flex flex-col gap-0.5">
											<a href={getRelativeLocaleUrl(locale, `/${item.type}/${monolocale ? item.id : item.id.split("/").slice(1).join("/")}`)} class="link font-semibold">
												{item.data.series && `${item.data.series} | `}
												{item.data.title}
											</a>
											<div class="flex items-center gap-2 text-sm text-secondary">
												{item.data.tags?.map(tag => (
													<a href={`${getRelativeLocaleUrl(locale, `/${item.type}`)}?tag=${encodeURIComponent(tag)}`} class="link">#{tag}</a>
												))}
												<time datetime={item.data.timestamp.toISOString()} class="font-mono text-xs">{Time.toString(item.data.timestamp)}</time>
											</div>
										</article>
									))
								) : (
									<span class="text-sm text-secondary">暂无</span>
								)
							}
						</div>

						<div class="sm:w-1/2 flex flex-col gap-2 sm:ps-6">
							<h5 class="text-sm font-bold text-secondary">随笔</h5>
							{
								recentJotList.length > 0 ? (
									recentJotList.map(item => (
										<article class="flex flex-col gap-0.5">
											<a href={getRelativeLocaleUrl(locale, `/${item.type}/${monolocale ? item.id : item.id.split("/").slice(1).join("/")}`)} class="link font-semibold">
												{item.data.title}
											</a>
											<div class="flex items-center gap-2 text-sm text-secondary">
												<time datetime={item.data.timestamp.toISOString()} class="font-mono text-xs">{Time.toString(item.data.timestamp)}</time>
											</div>
										</article>
									))
								) : (
									<span class="text-sm text-secondary">暂无</span>
								)
							}
						</div>
					</div>
				</section>
			)
		}

		{
			recentJottings.length > 0 && (
				<section class="flex flex-col gap-4">
					{/* 标题：✦ 片羽 ──────── */}
					<h4 class="flex items-center gap-2 text-lg font-bold">
						<svg viewBox="0 0 128 128" class="w-4 h-4 text-secondary" aria-hidden="true">
							<path d="M64 18 L75 53 L110 64 L75 75 L64 110 L53 75 L18 64 L53 53 Z" fill="currentColor" />
						</svg>
						片羽
						<span class="grow border-t border-weak"></span>
					</h4>

					{recentJottings.map(jotting => (
						<article class="flex flex-col gap-1 border-b border-dashed border-b-weak pb-2">
							<div class="markdown text-[0.95rem]"><jotting.Content /></div>
							<time datetime={jotting.data.timestamp.toISOString()} class="self-end text-sm text-secondary">
								—— {Time.toLocaleDateString(jotting.data.timestamp, locale)}
							</time>
						</article>
					))}
					<a href={getRelativeLocaleUrl(locale, "/jotting")} class="text-sm text-secondary self-end">更多随笔 →</a>
				</section>
			)
		}
	</main>
</Base>
